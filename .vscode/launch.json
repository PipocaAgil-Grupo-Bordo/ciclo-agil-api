{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Debug",
            "request": "launch",
            "command": "npm run start:debug",
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ]
        }
    ]
}